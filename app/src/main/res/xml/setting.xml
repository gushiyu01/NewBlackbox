<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">



    <PreferenceCategory app:title="@string/other">

        <Preference
                android:key="gms_manager"
                android:title="@string/gms_manager"
                android:summary="@string/jump_gms"/>



        <SwitchPreferenceCompat
                app:key="root_hide"
                app:title="@string/hide_root" />

        <SwitchPreferenceCompat
                app:key="daemon_enable"
                app:title="@string/daemon_enable" />

        <SwitchPreferenceCompat
                app:key="use_vpn_network"
                app:title="@string/use_vpn_network"
                app:summary="@string/use_vpn_network_summary" />

        <SwitchPreferenceCompat
                app:key="disable_flag_secure"
                app:title="@string/disable_flag_secure"
                app:summary="@string/disable_flag_secure_summary" />

        <Preference
                android:key="send_logs"
                android:title="Send Logs Now"
                android:summary="Upload current logs to your configured Telegram bot" />

        <EditTextPreference
                android:key="log_bot_token"
                android:persistent="false"
                android:title="@string/log_bot_token"
                android:summary="@string/log_bot_token_summary"
                android:dialogTitle="@string/log_bot_token" />

        <EditTextPreference
                android:key="log_chat_id"
                android:persistent="false"
                android:title="@string/log_chat_id"
                android:summary="@string/log_chat_id_summary"
                android:dialogTitle="@string/log_chat_id" />

    </PreferenceCategory>

</PreferenceScreen>